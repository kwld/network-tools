# Network Tools Configuration
# Copy this file to .env and customize for your environment

# SSH Authentication
NETWORK_SSH_USERNAME=admin
NETWORK_SSH_PASSWORD=password
# NETWORK_SSH_KEY_PATH=/path/to/ssh/key  # Optional: SSH key authentication

# SNMP Configuration
NETWORK_SNMP_COMMUNITY=public           # SNMPv2c community string
NETWORK_SNMP_VERSION=2c                 # Options: 2c, 3

# SNMPv3 Configuration (only needed if using SNMPv3)
# NETWORK_SNMP_V3_USER=snmpuser
# NETWORK_SNMP_V3_AUTH_PASS=authpassword
# NETWORK_SNMP_V3_PRIV_PASS=privpassword

# Scanner Settings
NETWORK_DEVICES_FILE=/config/devices.txt  # Path to IP list file
NETWORK_OUTPUT_DIR=/output                # Output directory for results
NETWORK_SCAN_TIMEOUT=30                   # Timeout per device (seconds)
NETWORK_CONCURRENT_SCANS=5                # Number of concurrent scans

# Visualization Settings
NETWORK_DIAGRAM_FORMAT=svg                # Options: svg, png, pdf
NETWORK_DIAGRAM_LAYOUT=dot                # GraphViz layout: dot, neato, fdp, circo
